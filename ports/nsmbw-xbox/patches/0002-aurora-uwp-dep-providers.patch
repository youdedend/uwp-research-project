--- a/aurora-main/cmake/AuroraDawnProvider.cmake
+++ b/aurora-main/cmake/AuroraDawnProvider.cmake
@@ -262,9 +262,46 @@ elseif (_aurora_dawn_provider STREQUAL "package")
     set(AURORA_DAWN_IS_SHARED FALSE PARENT_SCOPE)
   endif ()
 
+elseif (_aurora_dawn_provider STREQUAL "uwp_dep")
+  # ── UWP dep: pinned local prebuilt Dawn/WebGPU for Windows Store ──
+  if (NOT AURORA_WINDOWS_STORE)
+    message(FATAL_ERROR "aurora: AURORA_DAWN_PROVIDER=uwp_dep is only valid in the Windows Store lane.")
+  endif ()
+  if (NOT DEFINED AURORA_UWP_DEP_ROOT OR NOT EXISTS "${AURORA_UWP_DEP_ROOT}/x64/lib/webgpu_dawn.lib")
+    message(FATAL_ERROR
+      "aurora: AURORA_DAWN_PROVIDER=uwp_dep requires the main pinned uwp-dep "
+      "checkout with x64/lib/webgpu_dawn.lib; see cmake/AuroraUwpDep.cmake.")
+  endif ()
+
+  message(STATUS "aurora: Using Dawn/WebGPU from pinned uwp-dep (${AURORA_UWP_DEP_ROOT})")
+  set(_aurora_uwp_x64 "${AURORA_UWP_DEP_ROOT}/x64")
+  if (NOT TARGET dawn_webgpu_uwp_dep)
+    add_library(dawn_webgpu_uwp_dep SHARED IMPORTED GLOBAL)
+    set_target_properties(dawn_webgpu_uwp_dep PROPERTIES
+      IMPORTED_LOCATION "${_aurora_uwp_x64}/bin/webgpu_dawn.dll"
+      IMPORTED_IMPLIB "${_aurora_uwp_x64}/lib/webgpu_dawn.lib"
+      INTERFACE_INCLUDE_DIRECTORIES "${_aurora_uwp_x64}/include"
+    )
+  endif ()
+  if (NOT TARGET dawn::webgpu_dawn)
+    add_library(dawn::webgpu_dawn ALIAS dawn_webgpu_uwp_dep)
+  endif ()
+  unset(_aurora_uwp_x64)
+
+  # The bundled UWP Dawn is the D3D12/D3D11 path. Vulkan defines stay out of
+  # the Store compile set for this port.
+  set(DAWN_ENABLE_D3D12 ON CACHE INTERNAL "")
+  set(DAWN_ENABLE_D3D11 ON CACHE INTERNAL "")
+  set(DAWN_ENABLE_VULKAN OFF CACHE INTERNAL "")
+  set(DAWN_ENABLE_METAL OFF CACHE INTERNAL "")
+  set(DAWN_ENABLE_DESKTOP_GL OFF CACHE INTERNAL "")
+  set(DAWN_ENABLE_OPENGLES OFF CACHE INTERNAL "")
+  set(DAWN_ENABLE_NULL ON CACHE INTERNAL "")
+  set(AURORA_DAWN_IS_SHARED TRUE PARENT_SCOPE)
+
 else ()
   message(FATAL_ERROR "Invalid AURORA_DAWN_PROVIDER: ${AURORA_DAWN_PROVIDER} "
-    "(must be auto, vendor, system, or package)")
+    "(must be auto, vendor, system, package, or uwp_dep)")
 endif ()
 
