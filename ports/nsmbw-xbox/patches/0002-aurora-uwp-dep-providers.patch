diff --git a/aurora-main/cmake/AuroraUwpDep.cmake b/aurora-main/cmake/AuroraUwpDep.cmake
new file mode 100644
index 0000000..df29369
--- /dev/null
+++ b/aurora-main/cmake/AuroraUwpDep.cmake
@@ -0,0 +1,177 @@
+include_guard(GLOBAL)
+
+# NSMBW Xbox port: local, fail-closed access to the UWP prebuilt bundles.
+#
+# This is an adaptation of the uwp-dep provider idea from jajdp's MIT
+# retro-rewind-xbox recipe onto NSMBW's Aurora fork. Unlike the recipe, this
+# module never downloads the bundles and never falls back to a desktop Dawn,
+# SDL, or nod provider in the Windows Store lane. The two checkouts are local
+# and separate on purpose:
+#
+#   AURORA_UWP_DEP_SOURCE_DIR  XboxEmulationHub/uwp-dep @ 6ba4aad1...
+#                              Dawn/WebGPU, nod, libpng, zlib, DXC, libuwp.
+#   AURORA_UWP_SDL_SOURCE_DIR  XboxEmulationHub/uwp-dep @ ae39aa00...
+#                              SDL3 only. The main bundle's SDL3.dll is a
+#                              desktop build (non-_APP MSVC runtimes) and must
+#                              not be linked or packaged for UWP.
+
+if (NOT AURORA_WINDOWS_STORE)
+  if (AURORA_DAWN_PROVIDER STREQUAL "uwp_dep" OR
+      AURORA_SDL3_PROVIDER STREQUAL "uwp_dep" OR
+      AURORA_NOD_PROVIDER STREQUAL "uwp_dep")
+    message(FATAL_ERROR
+      "aurora: provider 'uwp_dep' is only valid for the Windows Store lane "
+      "(CMAKE_SYSTEM_NAME=WindowsStore).")
+  endif ()
+  return()
+endif ()
+
+if (NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
+  message(FATAL_ERROR "aurora: the pinned uwp-dep bundles contain Win64 binaries only.")
+endif ()
+
+set(AURORA_UWP_DEP_SOURCE_DIR "$ENV{AURORA_UWP_DEP_SOURCE_DIR}" CACHE PATH
+  "Local XboxEmulationHub/uwp-dep checkout at 6ba4aad18b0f149151784f31fd339225544e24f2")
+set(AURORA_UWP_SDL_SOURCE_DIR "$ENV{AURORA_UWP_SDL_SOURCE_DIR}" CACHE PATH
+  "Separate local XboxEmulationHub/uwp-dep SDL checkout at ae39aa004ae127bd00f8262d28b401f8e4ed8728")
+
+set(_aurora_uwp_dep_expected_commit "6ba4aad18b0f149151784f31fd339225544e24f2")
+set(_aurora_uwp_sdl_expected_commit "ae39aa004ae127bd00f8262d28b401f8e4ed8728")
+
+function(_aurora_uwp_require_file path description)
+  if (NOT EXISTS "${path}")
+    message(FATAL_ERROR
+      "aurora: Windows Store dependency check failed; missing ${description}: ${path}\n"
+      "Set AURORA_UWP_DEP_SOURCE_DIR and AURORA_UWP_SDL_SOURCE_DIR to the two "
+      "separate local checkouts described in cmake/AuroraUwpDep.cmake. "
+      "Aurora will not fall back to a desktop provider in this lane.")
+  endif ()
+endfunction()
+
+function(_aurora_uwp_check_git_pin root expected label)
+  if (NOT EXISTS "${root}/.git")
+    message(WARNING
+      "aurora: ${label} at ${root} is not a Git checkout; cannot verify that it "
+      "is commit ${expected}. Continuing with layout checks only.")
+    return()
+  endif ()
+
+  find_program(_aurora_uwp_git_executable git)
+  if (NOT _aurora_uwp_git_executable)
+    message(WARNING
+      "aurora: git was not found; cannot verify the ${label} commit at ${root}. "
+      "Continuing with layout checks only.")
+    return()
+  endif ()
+
+  execute_process(
+    COMMAND "${_aurora_uwp_git_executable}" -C "${root}" rev-parse HEAD
+    OUTPUT_VARIABLE _aurora_uwp_head
+    OUTPUT_STRIP_TRAILING_WHITESPACE
+    ERROR_QUIET
+    RESULT_VARIABLE _aurora_uwp_result
+  )
+  if (NOT _aurora_uwp_result EQUAL 0)
+    message(WARNING
+      "aurora: could not read the ${label} commit at ${root}; continuing with "
+      "layout checks only.")
+  elseif (NOT _aurora_uwp_head STREQUAL expected)
+    message(FATAL_ERROR
+      "aurora: ${label} is at commit ${_aurora_uwp_head}; expected ${expected} "
+      "(${root}). Use the exact pinned checkout for this port.")
+  endif ()
+endfunction()
+
+function(_aurora_uwp_select_provider provider_var linkage_var label)
+  set(_aurora_uwp_provider "${${provider_var}}")
+  if (_aurora_uwp_provider STREQUAL "system")
+    message(FATAL_ERROR
+      "aurora: ${label} provider 'system' is not accepted in the Windows Store "
+      "lane for this port; use 'uwp_dep' with the pinned local bundles.")
+  endif ()
+  if (NOT _aurora_uwp_provider STREQUAL "uwp_dep")
+    set(${provider_var} "uwp_dep" CACHE STRING "" FORCE)
+  endif ()
+  set(${linkage_var} "shared" CACHE STRING "" FORCE)
+endfunction()
+
+set(_aurora_uwp_need_main FALSE)
+if (AURORA_ENABLE_GX OR AURORA_ENABLE_DVD)
+  set(_aurora_uwp_need_main TRUE)
+endif ()
+
+_aurora_uwp_select_provider(AURORA_SDL3_PROVIDER AURORA_SDL3_LINKAGE "SDL3")
+if (AURORA_ENABLE_GX)
+  _aurora_uwp_select_provider(AURORA_DAWN_PROVIDER AURORA_DAWN_LINKAGE "Dawn")
+endif ()
+if (AURORA_ENABLE_DVD)
+  _aurora_uwp_select_provider(AURORA_NOD_PROVIDER AURORA_NOD_LINKAGE "nod")
+endif ()
+
+# Separate true-UWP SDL checkout. Headers, import library, and DLL all come
+# from here; do not add_subdirectory() it, because its CMakeLists describes
+# LIBUWP from that older bundle rather than the main pin below.
+if (NOT AURORA_UWP_SDL_SOURCE_DIR)
+  message(FATAL_ERROR
+    "aurora: AURORA_UWP_SDL_SOURCE_DIR is not set. Point it at a separate "
+    "XboxEmulationHub/uwp-dep checkout at ${_aurora_uwp_sdl_expected_commit} "
+    "for the true-UWP SDL3 (_APP MSVC runtimes).")
+endif ()
+get_filename_component(_aurora_uwp_sdl_root "${AURORA_UWP_SDL_SOURCE_DIR}" REALPATH)
+set(AURORA_UWP_SDL_ROOT "${_aurora_uwp_sdl_root}" CACHE INTERNAL "True-UWP SDL uwp-dep root")
+_aurora_uwp_check_git_pin("${AURORA_UWP_SDL_ROOT}" "${_aurora_uwp_sdl_expected_commit}" "true-UWP SDL bundle")
+_aurora_uwp_require_file("${AURORA_UWP_SDL_ROOT}/x64/include/SDL3/SDL.h" "true-UWP SDL header")
+_aurora_uwp_require_file("${AURORA_UWP_SDL_ROOT}/x64/lib/SDL3.lib" "true-UWP SDL import library")
+_aurora_uwp_require_file("${AURORA_UWP_SDL_ROOT}/x64/bin/SDL3.dll" "true-UWP SDL DLL")
+
+if (_aurora_uwp_need_main)
+  if (NOT AURORA_UWP_DEP_SOURCE_DIR)
+    message(FATAL_ERROR
+      "aurora: AURORA_UWP_DEP_SOURCE_DIR is not set. Point it at an "
+      "XboxEmulationHub/uwp-dep checkout at ${_aurora_uwp_dep_expected_commit} "
+      "for Dawn/nod/libuwp. Do not use that bundle's SDL3.dll.")
+  endif ()
+  get_filename_component(_aurora_uwp_dep_root "${AURORA_UWP_DEP_SOURCE_DIR}" REALPATH)
+  set(AURORA_UWP_DEP_ROOT "${_aurora_uwp_dep_root}" CACHE INTERNAL "Main uwp-dep root")
+
+  if (AURORA_UWP_DEP_ROOT STREQUAL AURORA_UWP_SDL_ROOT)
+    message(FATAL_ERROR
+      "aurora: AURORA_UWP_DEP_SOURCE_DIR and AURORA_UWP_SDL_SOURCE_DIR resolve "
+      "to the same folder (${AURORA_UWP_DEP_ROOT}). They must be separate "
+      "checkouts: main Dawn/nod/libuwp at ${_aurora_uwp_dep_expected_commit}, "
+      "SDL at ${_aurora_uwp_sdl_expected_commit}.")
+  endif ()
+
+  _aurora_uwp_check_git_pin("${AURORA_UWP_DEP_ROOT}" "${_aurora_uwp_dep_expected_commit}" "main uwp-dep bundle")
+  _aurora_uwp_require_file("${AURORA_UWP_DEP_ROOT}/CMakeLists.txt" "main uwp-dep CMakeLists")
+  _aurora_uwp_require_file("${AURORA_UWP_DEP_ROOT}/x64/include/libuwp.h" "libuwp header")
+  _aurora_uwp_require_file("${AURORA_UWP_DEP_ROOT}/x64/lib/libuwp.lib" "libuwp import library")
+  _aurora_uwp_require_file("${AURORA_UWP_DEP_ROOT}/x64/bin/libuwp.dll" "libuwp DLL")
+
+  if (AURORA_ENABLE_GX)
+    _aurora_uwp_require_file("${AURORA_UWP_DEP_ROOT}/x64/include/webgpu/webgpu.h" "UWP Dawn WebGPU header")
+    _aurora_uwp_require_file("${AURORA_UWP_DEP_ROOT}/x64/lib/webgpu_dawn.lib" "UWP Dawn import library")
+    _aurora_uwp_require_file("${AURORA_UWP_DEP_ROOT}/x64/bin/webgpu_dawn.dll" "UWP Dawn DLL")
+  endif ()
+  if (AURORA_ENABLE_DVD)
+    _aurora_uwp_require_file("${AURORA_UWP_DEP_ROOT}/x64/include/nod.h" "UWP nod header")
+    _aurora_uwp_require_file("${AURORA_UWP_DEP_ROOT}/x64/lib/nod.lib" "UWP nod import library")
+    _aurora_uwp_require_file("${AURORA_UWP_DEP_ROOT}/x64/bin/nod.dll" "UWP nod DLL")
+  endif ()
+
+  if (NOT TARGET LIBUWP)
+    add_subdirectory("${AURORA_UWP_DEP_ROOT}" "${CMAKE_BINARY_DIR}/_aurora_uwp_dep" EXCLUDE_FROM_ALL)
+  endif ()
+  if (NOT TARGET LIBUWP)
+    message(FATAL_ERROR "aurora: main uwp-dep bundle did not define imported target LIBUWP.")
+  endif ()
+  if (NOT TARGET aurora::uwp_dep)
+    add_library(aurora::uwp_dep ALIAS LIBUWP)
+  endif ()
+endif ()
+
+unset(_aurora_uwp_need_main)
+unset(_aurora_uwp_dep_root)
+unset(_aurora_uwp_sdl_root)
+unset(_aurora_uwp_dep_expected_commit)
+unset(_aurora_uwp_sdl_expected_commit)
